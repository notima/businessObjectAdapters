<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.notima.generic.businessobjects.adapter</groupId>
    <artifactId>businessObjectAdapters</artifactId>
    <version>1.11.0-SNAPSHOT</version>
  </parent>
  <artifactId>p27bankingAdapter</artifactId>
  <packaging>bundle</packaging>
  <name>P27 Banking Adapter</name>
  <description>Reads ISO 20022 bank files (camt.052, camt.053, camt.054) into payment batches.</description>

  <dependencies>
	  <dependency>
		  <groupId>org.notima.generic.businessobjects.adapter</groupId>
		  <artifactId>adapterTools</artifactId>
		  <version>${project.version}</version>
		  <type>bundle</type>
	  </dependency>
	  <dependency>
		  <groupId>org.notima</groupId>
		  <artifactId>iso20022lib</artifactId>
		  <version>${iso20022lib.version}</version>
	  </dependency>
  </dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<version>5.1.8</version>
				<extensions>true</extensions>
				<configuration>
					<instructions>
						<Bundle-Activator>org.notima.businessobjects.adapter.p27.Activator</Bundle-Activator>
						<Export-Package>org.notima.businessobjects.adapter.p27.*</Export-Package>
						<Private-Package>
							org.apache.karaf.util.tracker,
							org.apache.karaf.util.tracker.annotation
						</Private-Package>
					</instructions>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
