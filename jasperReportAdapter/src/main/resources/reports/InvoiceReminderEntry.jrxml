	</parameter>
	<parameter name="creditor" class="org.notima.generic.businessobjects.BusinessPartner" isForPrompting="false"/>
	<parameter name="letterDate" class="java.util.Date" isForPrompting="false"/>
	<parameter name="letterDueDate" class="java.util.Date" isForPrompting="false"/>
	<parameter name="bgNo" class="java.lang.String" isForPrompting="false"/>
	<parameter name="entryGrandTotal" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
	</parameter>
	<!-- True for a plusgiro payment slip (creditor's remitToAccountType PG), else bankgiro -->
	<parameter name="plusgiro" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[Boolean.FALSE]]></defaultValueExpression>
	</parameter>
	<parameter name="reminderFee" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[60.0]]></defaultValueExpression>
	</parameter>

