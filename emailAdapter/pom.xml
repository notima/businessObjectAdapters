<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	
	<parent>
		<groupId>org.notima.generic.businessobjects.adapter</groupId>
		<artifactId>businessObjectAdapters</artifactId>
		<version>1.10.2</version>
	</parent>
	
	<modelVersion>4.0.0</modelVersion>
	<artifactId>emailAdapter</artifactId>
	<packaging>bundle</packaging>
	<name>Email Sender</name>
	
	<properties>
		<bouncycastle.version>1.79</bouncycastle.version>
	</properties>

	<dependencies>

		<dependency>
			<groupId>
				org.notima.generic.businessobjects.adapter
			</groupId>
			<artifactId>adapterTools</artifactId>
			<version>${version}</version>
			<type>bundle</type>
		</dependency>
        
		<dependency>
			<groupId>com.sun.mail</groupId>
			<artifactId>javax.mail</artifactId>
			<version>1.6.2</version>
		</dependency>  
		
	   <dependency>
	        <groupId>org.osgi</groupId>
	        <artifactId>org.osgi.service.cm</artifactId>
	        <version>1.6.0</version>
	        <scope>provided</scope>
	    </dependency>		
		
		<!-- OpenPGP, only the lightweight API is used (no JCE provider) -->
		<dependency>
		    <groupId>org.bouncycastle</groupId>
		    <artifactId>bcpg-jdk18on</artifactId>
		    <version>${bouncycastle.version}</version>
		</dependency>
		
		<dependency>
		    <groupId>org.bouncycastle</groupId>
		    <artifactId>bcprov-jdk18on</artifactId>
		    <version>${bouncycastle.version}</version>
		</dependency>		

		<dependency>
		    <groupId>javax.jms</groupId>
		    <artifactId>javax.jms-api</artifactId>
		    <version>2.0.1</version>
		    <scope>provided</scope>
		</dependency>
		
		<!-- SMTP server for the tests -->
		<dependency>
			<groupId>com.icegreen</groupId>
			<artifactId>greenmail</artifactId>
			<version>1.6.15</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>com.sun.mail</groupId>
					<artifactId>jakarta.mail</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.sun.activation</groupId>
					<artifactId>jakarta.activation</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>1.7.36</version>
			<scope>test</scope>
		</dependency>
		
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<version>5.1.8</version>
				<extensions>true</extensions>
				<configuration>
					<instructions>
						<Bundle-Activator>org.notima.generic.pgp.Activator</Bundle-Activator>	
						<Export-Package>
							org.notima.generic.pgp.*
						</Export-Package>
						<Import-Package>
							org.glassfish.hk2.osgiresourcelocator;resolution:=optional,
							org.notima.generic.businessobjects,
							org.notima.generic.businessobjects.exception,
							org.notima.generic.businessobjects.util,
							org.notima.generic.ifacebusinessobjects,
							org.notima.businessobjects.adapter.tools,
							org.notima.businessobjects.adapter.tools.table,
							org.slf4j,
							com.google.gson,
							com.google.gson.annotations,
							javax.net.*,
							javax.naming,
							org.apache.karaf.shell.api.action,
							org.apache.karaf.shell.api.action.lifecycle,
							org.apache.karaf.shell.api.console,
							org.apache.karaf.shell.support.completers,
							org.apache.karaf.shell.support.table,
							org.osgi.framework;version="[1.6,2)",
    					    org.osgi.service.cm;version="[1.3,2)",
							*
						</Import-Package>
						<Embed-Dependency>*;scope=compile|runtime;
						artifactId=!slf4j-api|slf4j-log4j12|org.apache.felix.utils|notima-util|org.apache.karaf.jaas.boot|org.apache.karaf.shell.core|org.apache.karaf.util|log4j|businessobjects|sshd-core|threeten-jaxb-core|jline|javax.persistence-api|jakarta.activation-api|jakarta.xml.bind-api|javax.jms</Embed-Dependency>
						<Embed-Transitive>true</Embed-Transitive>
        				<Karaf-Commands>org.notima.generic.pgp.command*</Karaf-Commands>
					</instructions>
				</configuration>
			</plugin>

			<!-- JUnit 5 tests, not an AllTests suite (JUnit 4) as in the parent -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes combine.self="override">
						<include>**/*Test.java</include>
					</includes>
				</configuration>
			</plugin>

		</plugins>
	</build>

</project>